# ---------------------------------------------------------------------------
# PROG2002 Assessment 3 - API environment settings
# Copy this file to ".env" and fill in your own values.
# On SCU cPanel the same variable names are used by the Node.js application
# setup screen (Setup Node.js App -> Environment variables).
# ---------------------------------------------------------------------------

# Web server
PORT=3000

# MySQL connection (SCU cPanel prefixes the database and user with your username,
# e.g. database "student01_charity", user "student01_charityuser")
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charity_events

# Set to "true" to skip MySQL entirely and serve the demo dataset held in
# db/demo-data.json. Handy for a quick look at the website before the database
# has been imported, and for running the API tests.
USE_DEMO_DATA=false
